generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  MAJOR
  HIGH
  MEDIUM
  LOW
}

enum Status {
  OPEN
  IN_PROGRESS
  CLOSED
  ON_HOLD
  AS_IT_IS
}

enum QCStatusBBT {
  PASSED
  FAILED
  PENDING
  REJECTED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  googleId     String?   @unique @map("google_id") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.Text
  role         String    @default("admin") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("createdAt")
  updatedAt    DateTime  @default(now()) @map("updatedAt")
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  loginCodes   LoginVerificationCode[]

  @@map("user")
}

model LoginVerificationCode {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid @map("userId")
  codeHash  String    @map("code_hash") @db.Text
  expiresAt DateTime  @map("expiresAt")
  usedAt    DateTime? @map("usedAt")
  createdAt DateTime  @default(now()) @map("createdAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("login_verification_code")
}

model Session {
  id        String   @id @db.VarChar(128)
  userId    String   @db.Uuid @map("userId")
  expiresAt DateTime @map("expiresAt")
  createdAt DateTime @default(now()) @map("createdAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid @map("userId")
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expiresAt")
  usedAt    DateTime? @map("usedAt")
  createdAt DateTime  @default(now()) @map("createdAt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model Defect {
  id              String        @id @default(uuid())
  testCaseId      String?       @db.VarChar(100)
  dateReported    DateTime      @db.Date
  module          String        @db.VarChar(255)
  summary         String?       @db.Text
  expectedResult  String        @db.Text
  actualResult    String        @db.Text
  severity        Severity
  priority        String        @db.VarChar(100)
  assignedTo      String?       @db.VarChar(100)
  status          Status
  dateFixed       DateTime?     @db.Date
  qcStatusBbt     QCStatusBBT
  sourceFile      String?       @db.VarChar(255)
  createdAt       DateTime      @default(now())

  @@index([dateReported])
  @@index([module])
  @@index([severity])
  @@index([status])
  @@index([sourceFile])
}

enum TestExecutionStatus {
  NOT_RUN
  PASS
  FAIL
}

model TestCycle {
  id              String        @id @default(uuid())
  name            String        @db.VarChar(255)
  description     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  testCases       TestCase[]
  testExecutions  TestExecution[]

  @@map("test_cycle")
}

model TestCase {
  id              String        @id @default(uuid())
  testCaseId      String        @db.VarChar(100)
  title           String        @db.Text
  steps           String        @db.Text
  expectedResult  String        @db.Text
  cycleId         String        @db.Uuid @map("cycleId")
  createdAt       DateTime      @default(now())

  cycle           TestCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  testExecutions  TestExecution[]

  @@unique([testCaseId, cycleId])
  @@index([cycleId])
  @@map("test_case")
}

model TestExecution {
  id              String        @id @default(uuid())
  cycleId         String        @db.Uuid @map("cycleId")
  testCaseId      String        @db.Uuid @map("testCaseId")
  status          TestExecutionStatus @default(NOT_RUN)
  remarks         String?       @db.Text
  severity        Severity?
  executedOn      DateTime      @default(now()) @map("executedOn")
  executedBy      String?       @db.Uuid @map("executedBy")

  cycle           TestCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  testCase        TestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([cycleId, testCaseId])
  @@index([cycleId])
  @@index([testCaseId])
  @@map("test_execution")
}
